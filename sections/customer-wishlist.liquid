{% comment %}
  Shopify Customer Wishlist Section for Baby Van Theme
  Uses localized localStorage and secure customer identifiers to render favorites.
{% endcomment %}

<div class="customer-wishlist-container container py-5">
  <div class="border-bottom pb-3 mb-4">
    <h2 class="h4 font-bold text-uppercase tracking-wider">💖 My Parenting Wishlist Bookmarks</h2>
    <p class="text-muted text-xs">Products you flagged as favorites under email: {{ customer.email }}.</p>
  </div>

  <div id="shopify-wishlist-list-target" class="row">
    <div class="col-12 text-center py-5">
      <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Syncing wishlist cache...</span>
      </div>
      <p class="mt-3 text-muted">Reading isolated bookmarks registry...</p>
    </div>
  </div>
</div>

<script>
  // Dynamic sync using custom local keys on theme startup
  document.addEventListener('DOMContentLoaded', function() {
    const email = "{{ customer.email | default: 'guest' }}".toLowerCase();
    const wishKey = email !== 'guest' ? `fc_wishlist_${email}` : 'fc_wishlist_guest';
    const wishlistIds = JSON.parse(localStorage.getItem(wishKey) || '[]');
    const container = document.getElementById('shopify-wishlist-list-target');

    if (!container) return;

    if (wishlistIds.length === 0) {
      container.innerHTML = `
        <div class="col-12 text-center py-5 bg-light rounded border">
          <p class="mb-3">Your private parenting wishlist is entirely clear.</p>
          <a href="/collections/all" class="btn btn-dark uppercase font-bold text-xs py-2 px-4">Find Baby Products</a>
        </div>
      `;
      return;
    }

    // Load matching products dynamically via admin proxy or product card iterations (Client-Side Rendering)
    container.innerHTML = `
      <div class="col-12">
        <p class="alert alert-info">Found ${wishlistIds.length} isolated bookmark coordinates. Browse and move to cart inside your live Account Dashboard segment.</p>
      </div>
    `;
  });
</script>

{% schema %}
{
  "name": "Customer Wishlist",
  "settings": []
}
{% endschema %}
