{% comment %}
  Shopify Customer Baby Profile Section for Baby Van Theme
  Uses Customer account metafields to store multiple children names, genders and dates of birth.
{% endcomment %}

<div class="customer-baby-profile-container container py-5">
  <div class="border-bottom pb-3 mb-4">
    <h2 class="h4 font-bold text-uppercase tracking-wider">🤰 Baby Profiles & Metafields Ledger</h2>
    <p class="text-muted text-xs">Manage children information to receive customized pediatric growth mileposts.</p>
  </div>

  <div class="row">
    <!-- Showcase current metafield logs -->
    <div class="col-12 col-md-8">
      <div id="shopify-baby-profiles-target" class="row">
        <!-- Renders client side synced children from fc_registered_users or metafields -->
        <div class="col-12 py-4 bg-light rounded text-center border">
          <p class="text-muted mb-2">Syncing baby profiles linked with customer account...</p>
        </div>
      </div>
    </div>

    <!-- Add baby profile form simulated mockup representing metafield integration -->
    <div class="col-12 col-md-4">
      <div class="card p-4 bg-light border-orange">
        <h3 class="h6 font-bold uppercase tracking-wider mb-3">Add Baby Profile</h3>
        <form id="ShopifyMetafieldBabyForm" action="/accounts/metafields/baby" method="POST">
          <input type="hidden" name="customer_id" value="{{ customer.id }}">
          
          <div class="form-group mb-2">
            <label class="text-xs">Baby Name</label>
            <input type="text" name="baby_name" required class="form-control form-control-sm" placeholder="e.g. Ruhi Verma">
          </div>

          <div class="form-group mb-2">
            <label class="text-xs">Date of Birth</label>
            <input type="date" name="baby_dob" required class="font-mono form-control form-control-sm">
          </div>

          <div class="form-group mb-3">
            <label class="text-xs">Baby Gender</label>
            <select name="baby_gender" class="form-control form-control-sm">
              <option value="Boy">Baby Boy ♂</option>
              <option value="Girl">Baby Girl ♀</option>
            </select>
          </div>

          <button type="submit" class="btn btn-dark btn-sm w-100 text-uppercase font-extrabold font-sens">Save Metafield Log</button>
        </form>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer Baby Profile",
  "settings": []
}
{% endschema %}
